# Copy to .env and fill in. Never commit .env.

# Which adapter app/dependencies.py wires up: "anthropic" or "gemini".
LLM_PROVIDER=gemini

# --- Anthropic (used when LLM_PROVIDER=anthropic) --------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Optional: raise to claude-sonnet-5 if answer quality needs it.
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Gemini (used when LLM_PROVIDER=gemini) ---------------------------------
GEMINI_API_KEY=...
# "-latest" tracks whichever flash model Google currently serves. If your
# key still 404s on it, list what it can call (Google AI Studio, or
# client.models.list()) and set GEMINI_MODEL to one of those explicitly.
GEMINI_MODEL=gemini-flash-latest

# Required to enable POST /api/admin/reload. Unset = endpoint disabled.
ADMIN_TOKEN=

# Where the scraper leaves its export, relative to this directory.
LISTINGS_PATH=../annunci.json

# Frontend origin allowed by CORS (JSON list).
CORS_ORIGINS=["http://localhost:5173"]
